<!DOCTYPE html>
<html>
<head>
    <title>FORM</title>
    <style>
        label, p{
            color: rgb(116, 101, 17);
        }
    </style>
</head>
<body>
    <h2 align="center"><u>HTML FORM</u></h3><hr>
<form>
    <label>First Name:</label><br>
    <input type="text" name="First Name"><br><br>
    <label>Last Name:</label><br>
    <input type="text" name="Last Name"><br><br>
    <label>Select your Gender:</label><br><br>
    <input type="radio" name="Select your Gender">Male
    <input type="radio" name="Select your Gender">Female
    <input type="radio" name="Select your Gender">Other<br><br>
    <label>Password:</label><br>
    <input type="password" name="password"><br><br>
    <label>Confirm Password:</label><br>
    <input type="password" name="Confirm Password"><br><br>
    <label>EmailID:</label><br>
    <input type="email" name="EmailID"><br><br>
    <label>Mobile No:</label><br>
    <input type="text" name="Mobile No"><br><br>
    <label>Joining Date:</label><br>
    <input type="date" name="Joining Date"><br><br>
    <label>Points:</label><br>
    <input type="number" name="Points"><br><br><br>
    <label>Programms:</label><br>
    <select>
        <option>Web Development</option>
        <option value="Application development">Application development</option>
        <option value="Game Development">Game Development</option>
        <option value="Mobile deveploment">Mobile deveploment</option>
    </select><br><br>
    <label>Write about yourself:</label><br><br>
    <textarea cols="40" rows="10"></textarea><br><br>
    <p>Please read all the instructions carefully:</p>
    <input type="checkbox"> I read it carefully<br> <br>
    <input type="reset" name="reset" style="background-color: chocolate;"> Reset my form
    <input type="submit" name="submit"> Submit my form
</form>
</body>
</html>



